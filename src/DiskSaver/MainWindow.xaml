<Window x:Class="DiskSaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DiskSaver.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="DiskSaver — сохранение файлов перед форматированием"
        Width="1150" Height="720" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
    </Window.Resources>

    <DockPanel>
    <Menu DockPanel.Dock="Top" Padding="4,2">
        <MenuItem Header="_Файл">
            <MenuItem Header="_Выход" Click="Exit_Click" />
        </MenuItem>
        <MenuItem Header="_Настройки">
            <MenuItem Header="_Расширения файлов…" Click="Categories_Click"
                      IsEnabled="{Binding IsBusy, Converter={x:Static vm:InverseBool.Instance}}" />
        </MenuItem>
        <MenuItem Header="_Справка">
            <MenuItem Header="_О программе" Click="About_Click" />
        </MenuItem>
    </Menu>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Выбор диска -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Диск:" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ComboBox DockPanel.Dock="Left" Width="460" Margin="8,0,4,0" VerticalContentAlignment="Center"
                      ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                      DisplayMemberPath="Display" IsEnabled="{Binding IsBusy, Converter={x:Static vm:InverseBool.Instance}}" />
            <Button DockPanel.Dock="Left" Content="⟳ Обновить" Command="{Binding RefreshDrivesCommand}"
                    ToolTip="Обновить список дисков" />
            <Button DockPanel.Dock="Left" Content="Сканировать" FontWeight="SemiBold" Command="{Binding ScanCommand}" />
            <Button DockPanel.Dock="Left" Content="Стоп" Command="{Binding CancelCommand}" />

            <TextBox DockPanel.Dock="Right" Width="240" VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                     ToolTip="Поиск по имени и пути" />
            <TextBlock DockPanel.Dock="Right" Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0" />
        </DockPanel>

        <!-- Категории и файлы -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:CategoryViewModel">
                        <DockPanel Margin="2,5">
                            <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                      ToolTip="Отметить или снять все файлы категории" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Details}" Foreground="Gray" FontSize="12" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="FilesGrid" Grid.Row="0" ItemsSource="{Binding VisibleFiles}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="None"
                          AlternatingRowBackground="#F6F7F9" RowHeight="24"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding ShowInExplorerCommand}"
                                      CommandParameter="{Binding SelectedItem, ElementName=FilesGrid}" />
                    </DataGrid.InputBindings>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Открыть файл" Command="{Binding OpenFileCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem Header="Показать в проводнике" Command="{Binding ShowInExplorerCommand}"
                                      CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="34" SortMemberPath="IsSelected">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Папка" Binding="{Binding Folder}" Width="3*" />
                        <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="100" />
                        <DataGridTextColumn Header="Размер" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Изменён" Binding="{Binding Modified, StringFormat=dd.MM.yyyy HH:mm}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Grid.Row="0" Text="{Binding PlaceholderText}" Foreground="Gray" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="420" TextAlignment="Center" IsHitTestVisible="False"
                           Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVisibility}}" />

                <DockPanel Grid.Row="1" Margin="0,8,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Margin="0,0,4,0" Content="Отметить все в списке"
                            Command="{Binding SelectVisibleCommand}" />
                    <Button DockPanel.Dock="Left" Content="Снять все в списке" Command="{Binding UnselectVisibleCommand}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionSummary}"
                               VerticalAlignment="Center" FontWeight="SemiBold" />
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Куда копировать -->
        <GroupBox Grid.Row="2" Header="Куда сохранить архив" Margin="0,10,0,0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" VerticalContentAlignment="Center" MinHeight="28"
                         Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Папка на другом диске" />
                <Button Grid.Column="1" Content="Обзор…" Command="{Binding BrowseDestinationCommand}" />
                <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                    <RadioButton Content="Сохранить структуру папок" IsChecked="{Binding PreserveStructure}" />
                    <RadioButton Content="Разложить по категориям (фото/видео по годам)" IsChecked="{Binding ByCategory}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="3" Content="Копировать выбранное →" FontWeight="SemiBold"
                        Padding="18,6" Command="{Binding CopyCommand}" />
            </Grid>
        </GroupBox>

        <!-- Статус -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <ProgressBar DockPanel.Dock="Left" Width="220" Height="16"
                         Value="{Binding ProgressValue, Mode=OneWay}"
                         IsIndeterminate="{Binding ProgressIndeterminate}" />
            <TextBlock Text="{Binding StatusText}" Margin="10,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
        </DockPanel>
    </Grid>
    </DockPanel>
</Window>
