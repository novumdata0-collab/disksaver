<Window x:Class="DiskSaver.CategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DiskSaver.ViewModels"
        Title="Расширения файлов" Width="760" Height="500" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="Gray"
                   Text="Выберите категорию слева и отредактируйте её расширения или добавьте свою категорию. Изменения применяются после «Сохранить»." />

        <!-- Список категорий -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="+ Добавить" Click="Add_Click" />
                <Button Content="Удалить" Margin="6,0,0,0" Click="Remove_Click"
                        IsEnabled="{Binding SelectedItem, ElementName=CategoryList, Converter={x:Static local:NotNull.Instance}}" />
            </StackPanel>
            <ListBox x:Name="CategoryList" DisplayMemberPath="Name" />
        </DockPanel>

        <!-- Редактор выбранной категории -->
        <Grid Grid.Row="1" Grid.Column="1" DataContext="{Binding SelectedItem, ElementName=CategoryList}"
              IsEnabled="{Binding SelectedItem, ElementName=CategoryList, Converter={x:Static local:NotNull.Instance}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Название категории:" />
            <TextBox Grid.Row="1" Margin="0,4,0,10" MinHeight="26" VerticalContentAlignment="Center"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Text="Расширения (через запятую или пробел, точка не обязательна):" />
            <TextBox Grid.Row="3" Margin="0,4,0,10" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                     Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Row="4" Orientation="Horizontal">
                <TextBlock Text="Пропускать файлы меньше, КБ:" VerticalAlignment="Center" />
                <TextBox Width="80" Margin="8,0,0,0" MinHeight="26" VerticalContentAlignment="Center"
                         Text="{Binding MinSizeKbText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="0 — брать все файлы. Для фото полезно ~30 КБ, чтобы не собирать иконки." />
            </StackPanel>
            <CheckBox Grid.Row="5" Margin="0,10,0,0" Content="При раскладке по категориям делить по годам"
                      IsChecked="{Binding GroupByYear}" />
        </Grid>

        <!-- Кнопки -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Сбросить по умолчанию" Click="Reset_Click" />
            <Button DockPanel.Dock="Right" Content="Отмена" Margin="6,0,0,0" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="Сохранить" FontWeight="SemiBold" IsDefault="True" Click="Save_Click" />
        </DockPanel>
    </Grid>
</Window>
